NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Required for POST /v1/scrape. The example value below intentionally FAILS\n# production startup. Replace it with a random key from: openssl rand -hex 32.\n# A missing, placeholder, weak or malformed production bearer blocks API startup.
DOX_SCRAPER_API_KEY=replace-with-a-long-random-secret

# Optional Chromium rendering: disabled unless all settings are configured.
# This must only be used in a network-isolated worker with blocked private egress.
DOX_ENABLE_BROWSER_RENDERING=false
DOX_BROWSER_ALLOWED_ORIGINS=
DOX_CHROMIUM_PATH=

# Crawling is an explicit operator opt-in and requires an exact origin allowlist.
# Use only sites whose content you are authorized to crawl.
DOX_ENABLE_CRAWL_API=false
DOX_CRAWL_ALLOWED_ORIGINS=
DOX_CRAWL_DB_PATH=./storage/dox.sqlite

# Local MCP subprocess -> Hono REST base URL (MCP tools never call target sites directly).
DOX_MCP_API_URL=http://127.0.0.1:3000

# Raspberry Pi Docker Compose deployment (host-only API port).
DOX_BIND_PORT=3000
DOX_WORKER_INTERVAL_SECONDS=60

# Cloudflare Tunnel rollout. Keep empty during local-only setup.
# When routing a hostname through Cloudflare Access, set only the DNS hostname.
DOX_PUBLIC_HOSTNAME=
DOX_HTTP_ACCESS_LOGS=true

# Optional remote MCP client service token for Cloudflare Access:
# configure only in your local MCP client environment; never commit real values.
DOX_CF_ACCESS_CLIENT_ID=
DOX_CF_ACCESS_CLIENT_SECRET=

# Used by the opt-in verification script after Access and Tunnel setup.
DOX_PUBLIC_URL=
